rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'edgarmanosalva266@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // Test connection doc for initial boot validation
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins and Staff
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admisión: Postulantes
    match /applicants/{applicantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(applicantId);
      allow update, delete: if isStaffOrAdmin() && isValidId(applicantId);
    }

    // Registro de Estudiantes
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOrAdmin() && isValidId(studentId);
      allow delete: if isStaffOrAdmin() && isValidId(studentId);
    }

    // Matrículas Oficiales
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOrAdmin() && isValidId(enrollmentId);
      allow delete: if false;
    }

    // Calificaciones y Actas (LAG MINEDU)
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOrAdmin() && isValidId(gradeId);
      allow delete: if false;
    }

    // Tesorería y Pensiones
    match /treasury_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOrAdmin() && isValidId(paymentId);
      allow delete: if false;
    }

    // Facturación Electrónica SUNAT (Inmutable una vez emitida)
    match /sunat_invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isStaffOrAdmin() && isValidId(invoiceId);
      allow update, delete: if false; // Comprobante tributario inmutable
    }

    // Horarios y Carga Académica
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin() && isValidId(scheduleId);
    }

    // Sílabos de Unidades Didácticas
    match /syllabi/{syllabusId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOrAdmin() && isValidId(syllabusId);
      allow delete: if isStaffOrAdmin() && isValidId(syllabusId);
    }

    // Catálogo de Cursos y Malla Curricular
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin() && isValidId(courseId);
    }

    // Carreras y Programas de Estudio
    match /careers/{careerId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin() && isValidId(careerId);
    }

    // Plana Docente
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin() && isValidId(teacherId);
    }
  }
}
